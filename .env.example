# Variables de Entorno

# API Base URL
VITE_API_URL=http://localhost:8000

# Nombre de la aplicación
VITE_APP_NAME=Sistema de Ventas

# Payphone Configuration
# Obtén tu token desde https://payphone.app/dashboard
VITE_PAYPHONE_TOKEN=tu_token_de_payphone_aqui
VITE_PAYPHONE_BASE_URL=https://pay.payphonetodoesposible.com

# Configuración de impuestos (IVA)
VITE_TAX_RATE=0.15
